# functions/.env — non-secret settings for the prodPulseAI function (copy to .env).
# Secrets (XAI_API_KEY) go in Secret Manager, never here.

# Exact web origins allowed to call prodPulseAI, comma-separated (scheme + host).
# http://localhost:8081 is always allowed.
PRODPULSE_WEB_ORIGINS=https://your-production-domain.example

# Optional overrides
# XAI_MODEL=grok-4.7
# PRODUCTION_TIMEZONE=Asia/Kolkata

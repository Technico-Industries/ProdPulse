{
  "name": "prodpulse-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx test/prodPulseAI.test.ts && tsx test/cors.test.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions:prodPulseAI",
    "diagnose:gemini": "tsx scripts/diagnoseGemini.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
